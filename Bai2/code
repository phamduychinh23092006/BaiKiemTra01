static string DocChuoi(string thongBao)
{
    Console.Write(thongBao);
    return Console.ReadLine() ?? "";
}

static int DocSoNguyen(string thongBao)
{
    while (true)
    {
        Console.Write(thongBao);
        if (int.TryParse(Console.ReadLine(), out int kq)) return kq;
        Console.WriteLine("Vui lòng nhập một số nguyên hợp lệ.");
    }
}

static double DocSoThuc(string thongBao)
{
    while (true)
    {
        Console.Write(thongBao);
        string s = (Console.ReadLine() ?? "").Replace(',', '.');
        if (double.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out double kq)) return kq;
        Console.WriteLine("Vui lòng nhập một số hợp lệ (ví dụ 2.0).");
    }
}

static decimal DocDecimal(string thongBao)
{
    while (true)
    {
        Console.Write(thongBao);
        string s = (Console.ReadLine() ?? "").Replace(',', '.');
        if (decimal.TryParse(s, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal kq)) return kq;
        Console.WriteLine("Vui lòng nhập một số hợp lệ (ví dụ 800000000).");
    }
}

// ======================= CÁC LỚP =======================

public abstract class PhuongTien
{
    protected static readonly CultureInfo VN = new("vi-VN");

    private string _maPT = "PT000";
    private string _tenHang = string.Empty;
    private int _namSanXuat;
    private decimal _giaGoc;

    public string MaPT
    {
        get => _maPT;
        set => _maPT = string.IsNullOrWhiteSpace(value) ? "PT000" : value.Trim();
    }

    public string TenHang
    {
        get => _tenHang;
        set
        {
            if (string.IsNullOrWhiteSpace(value))
                throw new ArgumentException("Tên hãng không được để trống!");
            _tenHang = value.Trim();
        }
    }

    public int NamSanXuat
    {
        get => _namSanXuat;
        set
        {
            if (value < 1900 || value > DateTime.Now.Year)
                throw new ArgumentException("Năm sản xuất không hợp lệ!");
            _namSanXuat = value;
        }
    }

    public decimal GiaGoc
    {
        get => _giaGoc;
        set
        {
            if (value <= 0)
                throw new ArgumentException("Giá gốc phải lớn hơn 0!");
            _giaGoc = value;
        }
    }

    protected PhuongTien(string maPT, string tenHang, int namSanXuat, decimal giaGoc)
    {
        MaPT = maPT;
        TenHang = tenHang;
        NamSanXuat = namSanXuat;
        GiaGoc = giaGoc;
    }

    public abstract decimal TinhGiaLanBanh();

    public virtual string GetInfo() =>
        $"Mã: {MaPT} | Hãng: {TenHang} | Năm SX: {NamSanXuat} | Giá gốc: {FormatTien(GiaGoc)}";

    public static string FormatTien(decimal soTien) => soTien.ToString("N0", VN) + " VNĐ";
}

public class OTo : PhuongTien
{
    private int _soChoNgoi;
    private double _dungTichDongCo;

    public int SoChoNgoi
    {
        get => _soChoNgoi;
        set
        {
            if (value <= 0)
                throw new ArgumentException("Số chỗ ngồi phải lớn hơn 0!");
            _soChoNgoi = value;
        }
    }

    public double DungTichDongCo
    {
        get => _dungTichDongCo;
        set
        {
            if (value <= 0)
                throw new ArgumentException("Dung tích động cơ phải lớn hơn 0!");
            _dungTichDongCo = value;
        }
    }

    public OTo(string maPT, string tenHang, int namSanXuat, decimal giaGoc,
               int soChoNgoi, double dungTichDongCo)
        : base(maPT, tenHang, namSanXuat, giaGoc)
    {
        SoChoNgoi = soChoNgoi;
        DungTichDongCo = dungTichDongCo;
    }

    public override decimal TinhGiaLanBanh()
    {
        if (SoChoNgoi <= 9)
            return GiaGoc + GiaGoc * 0.12m + GiaGoc * 0.30m;   // trước bạ 12% + TTĐB 30%

        return GiaGoc + GiaGoc * 0.10m;                        // trước bạ 10%
    }

    public override string GetInfo() =>
        base.GetInfo() +
        $" | Số chỗ: {SoChoNgoi} | Dung tích động cơ: {DungTichDongCo.ToString("0.0", CultureInfo.InvariantCulture)} L";
}

public class XeMay : PhuongTien
{
    private int _dungTichXylanh;

    public int DungTichXylanh
    {
        get => _dungTichXylanh;
        set
        {
            if (value <= 0)
                throw new ArgumentException("Dung tích xy lanh phải lớn hơn 0!");
            _dungTichXylanh = value;
        }
    }

    public XeMay(string maPT, string tenHang, int namSanXuat, decimal giaGoc, int dungTichXylanh)
        : base(maPT, tenHang, namSanXuat, giaGoc)
    {
        DungTichXylanh = dungTichXylanh;
    }

    public override decimal TinhGiaLanBanh()
    {
        decimal tyLe = DungTichXylanh < 175 ? 0.02m : 0.05m;
        return GiaGoc + GiaGoc * tyLe;
    }

    public override string GetInfo() =>
        base.GetInfo() + $" | Dung tích xy lanh: {DungTichXylanh} cc";
}

public class QuanLyPhuongTien
{
    private readonly List<PhuongTien> _danhSach = new();

    public void AddPhuongTien(PhuongTien pt)
    {
        ArgumentNullException.ThrowIfNull(pt);
        _danhSach.Add(pt);
    }

    public void DisplayAll()
    {
        if (_danhSach.Count == 0)
        {
            Console.WriteLine("(Danh sách trống)");
            return;
        }

        int stt = 1;
        foreach (PhuongTien pt in _danhSach)
        {
            Console.WriteLine($"{stt++}. [{pt.GetType().Name}] {pt.GetInfo()} | Giá lăn bánh: {PhuongTien.FormatTien(pt.TinhGiaLanBanh())}");
        }
    }

    public PhuongTien? FindMaxGiaLanBanh() =>
        _danhSach.MaxBy(pt => pt.TinhGiaLanBanh());

    public List<PhuongTien> SearchByName(string keyword)
    {
        if (string.IsNullOrWhiteSpace(keyword))
            return new List<PhuongTien>();

        return _danhSach
            .Where(pt => pt.TenHang.Contains(keyword.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
}
