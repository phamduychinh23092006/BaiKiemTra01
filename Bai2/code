// ======================= TEST CASES =======================

static void ChayTestCase()
{
    Console.WriteLine();
    Console.WriteLine("=============== KỊCH BẢN KIỂM THỬ ===============");

    // TC01: Validation năm sản xuất
    Console.WriteLine("\n--- TC01: Kiểm tra Validation Năm sản xuất (NamSanXuat = 1850) ---");
    try
    {
        var oto = new OTo("OT01", "Toyota", 1850, 1_000_000_000m, 5, 2.0);
        Console.WriteLine("Đã tạo được đối tượng -> KHÔNG ném ngoại lệ");
        KetQua(false);
    }
    catch (ArgumentException ex)
    {
        Console.WriteLine($"ArgumentException: \"{ex.Message}\"");
        KetQua(ex.Message == "Năm sản xuất không hợp lệ!");
    }

    // TC02: Giá lăn bánh ô tô 5 chỗ
    Console.WriteLine("\n--- TC02: Giá lăn bánh Ô tô 5 chỗ, GiaGoc = 1.000.000.000 ---");
    var oto5 = new OTo("OT01", "Toyota", 2023, 1_000_000_000m, 5, 2.0);
    decimal gia1 = oto5.TinhGiaLanBanh();
    Console.WriteLine($"Giá lăn bánh = {PhuongTien.FormatTien(gia1)} (kỳ vọng 1.420.000.000 VNĐ)");
    KetQua(gia1 == 1_420_000_000m);

    // TC03: Giá lăn bánh xe máy 150cc
    Console.WriteLine("\n--- TC03: Giá lăn bánh Xe máy 150cc, GiaGoc = 50.000.000 ---");
    var xm150 = new XeMay("XM01", "Honda", 2024, 50_000_000m, 150);
    decimal gia2 = xm150.TinhGiaLanBanh();
    Console.WriteLine($"Giá lăn bánh = {PhuongTien.FormatTien(gia2)} (kỳ vọng 51.000.000 VNĐ)");
    KetQua(gia2 == 51_000_000m);

    // TC04: Đa hình trong List<PhuongTien>
    Console.WriteLine("\n--- TC04: Đa hình List<PhuongTien> ---");
    var ds = new List<PhuongTien> { oto5, xm150 };
    decimal[] kyVong = { 1_420_000_000m, 51_000_000m };
    bool dat4 = true;
    for (int i = 0; i < ds.Count; i++)
    {
        decimal g = ds[i].TinhGiaLanBanh();
        Console.WriteLine($"[{ds[i].GetType().Name}] {ds[i].MaPT}: {PhuongTien.FormatTien(g)}");
        if (g != kyVong[i]) dat4 = false;
    }
    KetQua(dat4);

    // TC05: Tìm giá lăn bánh max
    Console.WriteLine("\n--- TC05: FindMaxGiaLanBanh() ---");
    var qlTest = new QuanLyPhuongTien();
    qlTest.AddPhuongTien(oto5);
    qlTest.AddPhuongTien(xm150);
    PhuongTien? max = qlTest.FindMaxGiaLanBanh();
    if (max != null)
        Console.WriteLine($"Kết quả: [{max.GetType().Name}] {max.MaPT} - {PhuongTien.FormatTien(max.TinhGiaLanBanh())}");
    KetQua(max is OTo && max.TinhGiaLanBanh() == 1_420_000_000m);
}

static void KetQua(bool dat) =>
    Console.WriteLine(dat ? "=> Trạng thái: PASS" : "=> Trạng thái: FAIL");

